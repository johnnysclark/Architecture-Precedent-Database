# Copy this file to .env and fill in. .env is gitignored and never synced.

# Required for AI alt text and vision suggestions. Without it the app still runs;
# alt text is simply marked "needs API key" until you add one.
ANTHROPIC_API_KEY=

# Optional: pin the archive folder instead of choosing it in the UI on first run.
# PRECEDENTS_ARCHIVE_DIR=/Users/you/Pictures/Precedents

# Optional: override the vision model (defaults to claude-sonnet-4-6).
# PRECEDENTS_ALT_MODEL=claude-sonnet-4-6

# Optional: override the Anthropic endpoint (rarely needed).
# ANTHROPIC_BASE_URL=

# Optional: server port (default 8765).
# PORT=8765
